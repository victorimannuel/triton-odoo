<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="pl">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Profit and Loss</h2>
                        <p>
                            <strong>Company:</strong>
                            <span t-out="o.company_id.display_name" />
                            <br />
                            <strong>Period:</strong>
                            <span t-out="o.date_from" t-options="{'widget': 'date'}" />
                            -
                            <span t-out="o.date_to" t-options="{'widget': 'date'}" />
                        </p>
                        <table class="table table-sm o_main_table">
                            <thead>
                                <tr>
                                    <th>Description</th>
                                    <th class="text-end">Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="data['sections']" t-as="section">
                                    <tr>
                                        <td>
                                            <details open="open">
                                                <summary>
                                                    <strong t-out="section['label']" />
                                                </summary>
                                                <table
                                                    class="table table-sm"
                                                    style="margin: 8px 0 0 18px; width: calc(100% - 18px);"
                                                    t-if="section['lines']"
                                                >
                                                    <tbody>
                                                        <tr t-foreach="section['lines']" t-as="line">
                                                            <td style="border-top: none;">
                                                                <span t-out="line['label']" />
                                                            </td>
                                                            <td class="text-end" style="border-top: none;">
                                                                <span
                                                                    t-out="line['amount']"
                                                                    t-options="{'widget': 'monetary', 'display_currency': currency}"
                                                                />
                                                            </td>
                                                        </tr>
                                                    </tbody>
                                                </table>
                                            </details>
                                        </td>
                                        <td class="text-end">
                                            <span
                                                t-out="section['amount']"
                                                t-options="{'widget': 'monetary', 'display_currency': currency}"
                                            />
                                        </td>
                                    </tr>
                                </t>
                                <tr>
                                    <td><strong>Total Revenue</strong></td>
                                    <td class="text-end">
                                        <strong
                                            t-out="data['total_revenue']"
                                            t-options="{'widget': 'monetary', 'display_currency': currency}"
                                        />
                                    </td>
                                </tr>
                                <tr>
                                    <td><strong>Total Expense</strong></td>
                                    <td class="text-end">
                                        <strong
                                            t-out="data['total_expense']"
                                            t-options="{'widget': 'monetary', 'display_currency': currency}"
                                        />
                                    </td>
                                </tr>
                                <tr>
                                    <td><strong>Net Profit</strong></td>
                                    <td class="text-end">
                                        <strong
                                            t-out="data['net_profit']"
                                            t-options="{'widget': 'monetary', 'display_currency': currency}"
                                        />
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>

        <template id="bs"><t t-call="web.html_container"><t t-foreach="docs" t-as="o"><t t-call="web.external_layout"><div class="page bs"><style>.bs{font-size:12px}.bs .meta{border-bottom:2px solid #4f3b66;margin-bottom:14px}.bs h2{color:#4f3b66}.bs table{width:100%;border-collapse:collapse;table-layout:fixed}.bs th{background:#4f3b66;color:#fff;padding:8px;text-transform:uppercase}.bs td{border:1px solid #d1d5db;padding:7px}.bs th:first-child,.bs td:first-child{width:64%}.bs .amount{text-align:right;white-space:nowrap}.bs .section td{background:#f3f0f6;font-weight:bold}.bs .detail td:first-child{padding-left:22px}.bs .grand td{background:#4f3b66;color:#fff;font-weight:bold}.bs .difference td{background:#fef3c7;font-weight:bold}.bs a{color:#1d4ed8;text-decoration:none}</style><div class="meta"><h2>Balance Sheet</h2><b>Company:</b> <span t-out="o.company_id.display_name"/><br/><b>As of:</b> <span t-out="o.date_to" t-options="{'widget':'date'}"/></div><div class="row"><div class="col-6"><t t-call="account_custom_financial_statements.bs_table"><t t-set="title" t-value="'Assets'"/><t t-set="sections" t-value="data['asset_sections']"/><t t-set="label" t-value="'Total Assets'"/><t t-set="amount" t-value="data['total_assets']"/></t></div><div class="col-6"><t t-call="account_custom_financial_statements.bs_table"><t t-set="title" t-value="'Liabilities and Equity'"/><t t-set="sections" t-value="data['liability_sections'] + data['equity_sections']"/><t t-set="label" t-value="'Total Liabilities + Equity'"/><t t-set="amount" t-value="data['total_liabilities_equity']"/></t><table style="margin-top:10px"><tr class="difference"><td>Difference</td><td class="amount"><span t-out="data['difference']" t-options="{'widget':'monetary','display_currency':currency}"/></td></tr></table></div></div></div></t></t></t></template><template id="bs_table"><table><thead><tr><th t-out="title"/><th class="amount">Amount</th></tr></thead><tbody><t t-foreach="sections" t-as="section"><tr class="section"><td><a t-att-href="section['url']" target="_blank"><span t-out="section['label']"/></a></td><td class="amount"><span t-out="section['amount']" t-options="{'widget':'monetary','display_currency':currency}"/></td></tr><tr class="detail" t-foreach="section['lines']" t-as="line"><td><a t-att-href="line['url']" target="_blank"><span t-out="line['label']"/></a></td><td class="amount"><span t-out="line['amount']" t-options="{'widget':'monetary','display_currency':currency}"/></td></tr></t><tr class="grand"><td t-out="label"/><td class="amount"><span t-out="amount" t-options="{'widget':'monetary','display_currency':currency}"/></td></tr></tbody></table></template></odoo>