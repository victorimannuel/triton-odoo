<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="res.groups.privilege" id="res_groups_privilege_operations">
        <field name="name">Operations</field>
        <field name="sequence">20</field>
        <field name="category_id" ref="base.module_category_services"/>
    </record>

    <record id="group_operation_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="res_groups_privilege_operations"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">The user will have access to their own operation tasks.</field>
    </record>

    <record id="group_operation_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_operations"/>
        <field name="implied_ids" eval="[(4, ref('group_operation_user'))]"/>
        <field name="comment">The user will have access to the full Helicopter View of operations.</field>
    </record>
</odoo>
