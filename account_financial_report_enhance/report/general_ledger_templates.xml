<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- =====================================================
         1. TOGGLE: collapsible account sections
         Rows start as "show" so PDF export renders everything.
         ===================================================== -->
    <template
        id="report_general_ledger_base_toggle"
        inherit_id="account_financial_report.report_general_ledger_base"
    >
        <!-- Replace the entire account page_break block to safely wrap its contents in a valid XML div -->
        <xpath
            expr="//div[@class='page']/t[@t-foreach='general_ledger']/div[@class='page_break']"
            position="replace"
        >
            <div class="page_break">
                <!-- Display account header -->
                <div class="act_as_table list_table" style="margin-top: 10px;" />
                <!-- Hidden checkbox for CSS toggle hack -->
                <input
                    type="checkbox"
                    class="gl-toggle-checkbox d-none"
                    t-att-id="'gl_toggle_' + account['code'].replace('.', '_')"
                />
                
                <!-- Label acts as the clickable toggle button -->
                <label
                    class="act_as_caption account_title"
                    style="width: 100%; cursor: pointer; user-select: none; margin-bottom: 0;"
                    t-att-for="'gl_toggle_' + account['code'].replace('.', '_')"
                >
                    <span class="gl-toggle-icon">&#9660;</span>
                    <span t-out="account['code']" />
                    -
                    <span t-out="account['name']" />
                </label>
                
                <!-- The Collapse Wrapper -->
                <div class="gl-collapse-wrapper">
                    <t t-if="'list_grouped' not in account">
                        <!-- Display account move lines without partner regroup -->
                        <t t-set="type" t-value='"account_type"' />
                        <t t-call="account_financial_report.report_general_ledger_lines">
                            <t t-set="account_or_group_item_object" t-value="account" />
                        </t>
                        <!-- Display account footer -->
                        <t t-call="account_financial_report.report_general_ledger_ending_cumul">
                            <t t-set="account_or_group_item_object" t-value="account" />
                            <t t-set="type" t-value='"account_type"' />
                        </t>
                    </t>
                    <t t-if="'list_grouped' in account">
                        <!-- Display account partners -->
                        <t t-foreach="account['list_grouped']" t-as="group_item">
                            <t t-set="type" t-value='"grouped_type"' />
                            <div class="page_break">
                                <!-- Display partner header -->
                                <div class="act_as_caption account_title">
                                    <span t-out="group_item['name']" />
                                </div>
                                <!-- Display partner move lines -->
                                <t t-call="account_financial_report.report_general_ledger_lines">
                                    <t t-set="account_or_group_item_object" t-value="group_item" />
                                </t>
                                <!-- Display partner footer -->
                                <t t-call="account_financial_report.report_general_ledger_ending_cumul">
                                    <t t-set="account_or_group_item_object" t-value="group_item" />
                                    <t t-set="type" t-value='"grouped_type"' />
                                </t>
                            </div>
                        </t>
                        <!-- Display account footer -->
                        <t t-if="not filter_partner_ids">
                            <t t-call="account_financial_report.report_general_ledger_ending_cumul">
                                <t t-set="account_or_group_item_object" t-value="account" />
                                <t t-set="type" t-value='"account_type"' />
                            </t>
                        </t>
                    </t>
                </div>
            </div>
        </xpath>
    </template>

    <!-- =====================================================
         2. GRAND TOTAL: summary row after all accounts
         ===================================================== -->
    <template
        id="report_general_ledger_base_inherit_total"
        inherit_id="account_financial_report.report_general_ledger_base"
    >
        <xpath expr="//div[@class='page']/t[@t-foreach='general_ledger']" position="after">
            <t t-if="gl_totals and gl_totals['has_accounts']">
                <div class="page_break">
                    <div class="act_as_table list_table" style="width: 100%; margin-top: 10px;">
                        <div class="act_as_row labels" style="font-weight: bold;">
                            <div class="act_as_cell first_column" style="width: 40.5%;">All Accounts</div>
                            <div class="act_as_cell right" style="width: 16%;">Grand total</div>
                            <t t-if="show_cost_center">
                                <div class="act_as_cell" style="width: 8.03%;" />
                            </t>
                            <t t-if="show_analytic_tags">
                                <div class="act_as_cell" style="width: 4.75%;" />
                            </t>
                            <div class="act_as_cell" style="width: 2.41%;" />
                            <div class="act_as_cell amount" style="width: 8.02%;">
                                <span
                                    t-out="gl_totals['fin_debit']"
                                    t-options="{'widget': 'monetary', 'display_currency': company_currency}"
                                />
                            </div>
                            <div class="act_as_cell amount" style="width: 8.02%;">
                                <span
                                    t-out="gl_totals['fin_credit']"
                                    t-options="{'widget': 'monetary', 'display_currency': company_currency}"
                                />
                            </div>
                            <div class="act_as_cell amount" style="width: 8.02%;">
                                <span
                                    t-out="gl_totals['fin_balance']"
                                    t-options="{'widget': 'monetary', 'display_currency': company_currency}"
                                />
                            </div>
                            <t t-if="foreign_currency">
                                <div class="act_as_cell" style="width: 3.63%;" />
                                <div class="act_as_cell" style="width: 3.63%;" />
                            </t>
                        </div>
                    </div>
                </div>
            </t>
        </xpath>
    </template>


</odoo>
