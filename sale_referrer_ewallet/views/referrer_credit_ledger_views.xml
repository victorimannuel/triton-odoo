<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_referrer_credit_ledger_tree" model="ir.ui.view">
        <field name="name">sale.referrer.wallet.transaction.tree</field>
        <field name="model">sale.referrer.wallet.transaction</field>
        <field name="arch" type="xml">
            <list string="Referrer Wallet Transactions" create="false" delete="false">
                <field name="create_date" string="Date"/>
                <field name="partner_id"/>
                <field name="source_invoice_id"/>
                <field name="sale_order_id"/>
                <field name="accounting_move_id" optional="hide"/>
                <field name="transaction_type"/>
                <field name="amount"/>
                <field name="odoo_ewallet_sync_state" optional="hide"/>
                <field name="state" widget="badge" decoration-success="state == 'posted'"/>
            </list>
        </field>
    </record>

    <record id="view_referrer_credit_ledger_form" model="ir.ui.view">
        <field name="name">sale.referrer.wallet.transaction.form</field>
        <field name="model">sale.referrer.wallet.transaction</field>
        <field name="arch" type="xml">
            <form string="Referrer Wallet Transaction" create="false" edit="false" delete="false">
                <header>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="source_invoice_id"/>
                            <field name="sale_order_id"/>
                            <field name="reversal_of_id"/>
                        </group>
                        <group>
                            <field name="amount"/>
                            <field name="transaction_type"/>
                            <field name="reference"/>
                            <field name="accounting_move_id"/>
                            <field name="odoo_ewallet_sync_state"/>
                            <field name="odoo_ewallet_sync_note"/>
                            <field name="create_date"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_referrer_credit_ledger" model="ir.actions.act_window">
        <field name="name">Referrer Wallet Ledger</field>
        <field name="res_model">sale.referrer.wallet.transaction</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
