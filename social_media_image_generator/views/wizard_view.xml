<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── Wizard Form ────────────────────────────────── -->
    <record id="view_socmed_image_wizard_form" model="ir.ui.view">
        <field name="name">socmed.image.wizard.form</field>
        <field name="model">socmed.image.wizard</field>
        <field name="arch" type="xml">
            <form string="Generate Social Media Image">
                <sheet>
                    <group col="2">
                        <group string="1. Pilih Template" col="2">
                            <field name="template" widget="radio" options="{'inline': True}"/>
                        </group>
                        <group string="2. Pilih Platform" col="2">
                            <field name="platform" widget="radio" options="{'inline': True}"/>
                        </group>
                    </group>

                    <group string="3. Isi Konten" col="2">
                        <!-- Generic fields -->
                        <field name="main_text" placeholder="Judul utama"/>
                        <field name="subtitle" placeholder="Subtitle / tagline"/>
                        <field name="description" placeholder="Deskripsi / bullet list&#10;Pisahkan dengan Enter" colspan="2"/>

                        <!-- Announcement-specific -->
                        <field name="badge_text" placeholder="Label / stiker"
                               attrs="{'invisible': [('template', 'not in', ('announcement', 'tips'))]}"/>
                        <field name="promo_code" placeholder="Kode promo"
                               attrs="{'invisible': [('template', '!=', 'announcement')]}"/>
                        <field name="valid_until"
                               attrs="{'invisible': [('template', '!=', 'announcement')]}"/>

                        <!-- Quote-only -->
                        <field name="customer_name" placeholder="Nama orang"
                               attrs="{'invisible': [('template', '!=', 'quote')]}"/>
                        <field name="customer_title" placeholder="Deskripsi / asal"
                               attrs="{'invisible': [('template', '!=', 'quote')]}"/>
                        <field name="quote" placeholder="Tulis quote atau testimonial di sini..."
                               attrs="{'invisible': [('template', '!=', 'quote')]}" colspan="2"/>

                        <!-- Event-only -->
                        <field name="event_date"
                               attrs="{'invisible': [('template', '!=', 'event')]}"/>
                        <field name="event_location" placeholder="Lokasi (Online / Gedung X)"
                               attrs="{'invisible': [('template', '!=', 'event')]}"/>
                        <field name="cta_text" placeholder="Tombol CTA"
                               attrs="{'invisible': [('template', 'not in', ('event', 'tips'))]}"/>
                    </group>

                    <!-- Preview -->
                    <group string="4. Preview" col="2"
                           attrs="{'invisible': [('image_preview', '=', False)]}">
                        <field name="image_preview" widget="image"
                               options="{'size': [400, 400]}"
                               readonly="1"/>
                        <field name="image_filename" invisible="1"/>
                    </group>
                </sheet>

                <footer>
                    <button name="action_generate" string="🚀 Generate"
                            type="object" class="btn-primary"/>
                    <button name="action_download" string="⬇️ Download PNG"
                            type="object" class="btn-success"
                            attrs="{'invisible': [('image_preview', '=', False)]}"/>
                    <button string="Batal" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- ── Action ─────────────────────────────────────── -->
    <record id="action_socmed_image_wizard" model="ir.actions.act_window">
        <field name="name">Generate Social Media Image</field>
        <field name="res_model">socmed.image.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="help" type="html">
            <p>Buat gambar postingan sosial media langsung dari Odoo!</p>
            <ul>
                <li>Pilih template — Announcement, Tips, Quote, Event, atau Custom</li>
                <li>Pilih ukuran — Instagram Post, Story, atau Facebook/LinkedIn</li>
                <li>Isi teks dan generate — langsung download PNG</li>
            </ul>
        </field>
    </record>

</odoo>