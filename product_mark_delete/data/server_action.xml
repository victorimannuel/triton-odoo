<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_bulk_delete_marked_products" model="ir.actions.server">
        <field name="name">Bulk Delete Marked Products</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
# Deletes the selected products if they are marked to be deleted
to_delete = records.filtered('to_be_deleted')
if to_delete:
    to_delete.unlink()
        </field>
    </record>
</odoo>
