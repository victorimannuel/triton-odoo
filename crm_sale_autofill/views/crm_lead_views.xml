<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_crm_lead_ai_autofill" model="ir.ui.view">
        <field name="name">crm.lead.suggested.autofill</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/notebook" position="inside">
                <page string="Suggested Products" name="suggested_products_page">
                    <field name="suggested_product_line_ids">
                        <list editable="bottom">
                            <field name="product_id"/>
                            <field name="name"/>
                            <field name="quantity"/>
                            <field name="price_unit"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
