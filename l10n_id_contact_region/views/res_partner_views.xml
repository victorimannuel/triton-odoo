<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_indonesia_daerah" model="ir.ui.view">
        <field name="name">res.partner.form.indonesia.daerah</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='city']" position="after">
                <field name="city_id" placeholder="Kabupaten / Kota" options="{'no_create_edit': True}"/>
                <field name="district_id" placeholder="District" options="{'no_create_edit': True}"/>
                <field name="village_id" placeholder="Desa / Kelurahan" options="{'no_create_edit': True}"/>
            </xpath>
        </field>
    </record>

    <record id="view_res_partner_filter_indonesia_daerah" model="ir.ui.view">
        <field name="name">res.partner.search.indonesia.daerah</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='group_by']" position="inside">
                <filter name="group_by_state_id_local" string="Provinsi" context="{'group_by': 'state_id'}"/>
                <filter name="group_by_city_id_local" string="Kabupaten / Kota" context="{'group_by': 'city_id'}"/>
                <filter name="group_by_district_id_local" string="District" context="{'group_by': 'district_id'}"/>
                <filter name="group_by_village_id_local" string="Desa / Kelurahan" context="{'group_by': 'village_id'}"/>
            </xpath>
        </field>
    </record>
</odoo>
