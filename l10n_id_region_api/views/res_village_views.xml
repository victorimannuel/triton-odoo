<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_village_view_search" model="ir.ui.view">
        <field name="name">res.village.search</field>
        <field name="model">res.village</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="district_id"/>
                <field name="zip"/>
                <filter name="active" string="Active" domain="[('active', '=', True)]"/>
                <filter name="inactive" string="Inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="res_village_view_list" model="ir.ui.view">
        <field name="name">res.village.list</field>
        <field name="model">res.village</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="district_id"/>
                <field name="zip"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="res_village_view_form" model="ir.ui.view">
        <field name="name">res.village.form</field>
        <field name="model">res.village</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="district_id"/>
                        <field name="zip"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="res_village_action" model="ir.actions.act_window">
        <field name="name">Desa / Kelurahan</field>
        <field name="res_model">res.village</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="res_village_menu" parent="contacts.menu_localisation" action="res_village_action" sequence="93" groups="base.group_system"/>

    <record id="ir_actions_server_sync_indonesia_regions" model="ir.actions.server">
        <field name="name">Sync Indonesia Regions</field>
        <field name="model_id" ref="base.model_ir_config_parameter"/>
        <field name="state">code</field>
        <field name="code">env['id.region.sync.service'].action_sync_all_regions()</field>
    </record>
</odoo>
