<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_task_assignment_log_tree" model="ir.ui.view">
        <field name="name">task.assignment.log.tree</field>
        <field name="model">task.assignment.log</field>
        <field name="arch" type="xml">
            <tree string="Assignment Logs" default_order="create_date DESC">
                <field name="create_date"/>
                <field name="task_id"/>
                <field name="rule_id"/>
                <field name="strategy"/>
                <field name="assigned_user_id"/>
                <field name="previous_user_id"/>
                <field name="trigger"/>
            </tree>
        </field>
    </record>

    <record id="view_task_assignment_log_form" model="ir.ui.view">
        <field name="name">task.assignment.log.form</field>
        <field name="model">task.assignment.log</field>
        <field name="arch" type="xml">
            <form string="Assignment Log">
                <sheet>
                    <group>
                        <group>
                            <field name="task_id"/>
                            <field name="rule_id"/>
                            <field name="strategy"/>
                            <field name="trigger"/>
                        </group>
                        <group>
                            <field name="assigned_user_id"/>
                            <field name="previous_user_id"/>
                            <field name="create_date" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_task_assignment_log_search" model="ir.ui.view">
        <field name="name">task.assignment.log.search</field>
        <field name="model">task.assignment.log</field>
        <field name="arch" type="xml">
            <search string="Assignment Logs">
                <field name="task_id"/>
                <field name="rule_id"/>
                <field name="assigned_user_id"/>
                <filter name="trigger_create" string="On Create" domain="[('trigger', '=', 'create')]"/>
                <filter name="trigger_stage_change" string="On Stage Change" domain="[('trigger', '=', 'stage_change')]"/>
            </search>
        </field>
    </record>

    <record id="action_task_assignment_log" model="ir.actions.act_window">
        <field name="name">Assignment Log</field>
        <field name="res_model">task.assignment.log</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No assignments logged yet
            </p>
            <p>
                When assignment rules are applied to tasks, the log entries
                will appear here.
            </p>
        </field>
    </record>
</odoo>